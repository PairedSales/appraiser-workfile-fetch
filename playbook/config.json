{
  "_about": "Lookup table for the workfile fetch. fetch.py reads it. Add a county: add an entry under counties plus counties/<key>.md. Add a deliverable: add an entry under deliverables plus deliverables/<key>.md (and a section in each county sheet if it is county specific). Run python fetch/fetch.py check after any edit.",

  "workfiles_dir": "Workfiles",
  "data_dir": "_data",
  "state_file": "_fetch-state.json",
  "lock_file": "_fetch.lock",
  "run_log": "_run-log.txt",
  "issues_index": "_open-issues.tsv",
  "test_root": "_fetch-test",
  "timezone": "America/Chicago",

  "max_attempts": 3,
  "reasons_that_never_give_up": ["LOGIN_WALL"],
  "reason_codes": ["LOGIN_WALL", "DOMAIN_REFUSED", "NOT_FOUND", "UNCERTAIN_MATCH", "SERVICE_DOWN", "PRINT_FAILED",
                   "DOWNLOAD_NOT_REACHABLE", "ON_SITE_ONLY", "TOOL_MISSING", "BROWSER_UNAVAILABLE", "OTHER"],

  "signin_sites": {
    "connectmls": {"name": "connectMLS", "domain": "connectmls.mredllc.com",
                   "how": "playbook/deliverables/mls-listing.md, section Sign-in check"}
  },

  "counties": {
    "COOK":    {"name": "Cook",    "sheet": "counties/cook.md",
                "deliverables": ["legal-description", "plat-map", "zoning", "tax-page"],
                "recipes": ["browser", "pdf-sheets", "html-capture", "tiled-capture", "municipal-zoning", "saving-files"]},
    "DUPAGE":  {"name": "DuPage",  "sheet": "counties/dupage.md",
                "deliverables": ["legal-description", "plat-map", "zoning"],
                "recipes": ["browser", "pdf-sheets", "html-capture", "tiled-capture", "municipal-zoning", "saving-files"]},
    "KANE":    {"name": "Kane",    "sheet": "counties/kane.md",
                "deliverables": ["legal-description", "plat-map", "zoning"],
                "recipes": ["browser", "pdf-sheets", "html-capture", "tiled-capture", "municipal-zoning", "saving-files"]},
    "LAKE":    {"name": "Lake",    "sheet": "counties/lake.md",
                "deliverables": ["plat-map", "zoning"], "abbrev_legal": true,
                "no_legal": "Lake County publishes no free recorded document images",
                "recipes": ["browser", "pdf-sheets", "html-capture", "tiled-capture", "municipal-zoning", "saving-files"]},
    "MCHENRY": {"name": "McHenry", "sheet": "counties/mchenry.md",
                "deliverables": ["plat-map", "zoning", "tax-page"], "abbrev_legal": true,
                "no_legal": "the McHenry Recorder offers no free document images",
                "recipes": ["browser", "pdf-sheets", "html-capture", "tiled-capture", "municipal-zoning", "saving-files"]},
    "WILL":    {"name": "Will",    "sheet": "counties/will.md",
                "deliverables": ["property-card", "plat-map", "zoning"], "abbrev_legal": true,
                "no_legal": "the Will County Recorder offers no free document images",
                "recipes": ["browser", "pdf-sheets", "html-capture", "tiled-capture", "municipal-zoning", "saving-files"]},
    "KENDALL": {"name": "Kendall", "sheet": "counties/kendall.md",
                "deliverables": ["plat-map", "zoning"], "abbrev_legal": true,
                "no_legal": "Kendall County recorded images are subscription only (Laredo)",
                "recipes": ["browser", "pdf-sheets", "html-capture", "tiled-capture", "municipal-zoning", "saving-files"]},
    "DEKALB":  {"name": "DeKalb",  "sheet": "counties/dekalb.md",
                "deliverables": ["legal-description", "plat-map", "zoning"],
                "recipes": ["browser", "pdf-sheets", "html-capture", "tiled-capture", "municipal-zoning", "saving-files"]}
  },

  "deliverables": {
    "legal-description": {"files": ["legal-description-{slug}.png"], "required": true,  "procedure": "county",
                          "spec": "deliverables/legal-description.md"},
    "plat-map":          {"files": ["plat-map-{slug}.png"],          "required": true,  "procedure": "county",
                          "spec": "deliverables/plat-map.md"},
    "zoning":            {"files": ["zoning-{slug}.png"],            "required": true,  "procedure": "county",
                          "spec": "deliverables/zoning.md"},
    "tax-page":          {"any_of": ["tax-page-{slug}.pdf", "tax-page-{slug}.png"], "required": true,  "procedure": "county",
                          "spec": "deliverables/tax-page.md"},
    "property-card":     {"any_of": ["property-card-{slug}.pdf", "property-card-{slug}.png"], "required": true,  "procedure": "county",
                          "spec": "deliverables/property-card.md"},
    "township-card":     {"files": ["township-card-{slug}.png"],     "required": false, "procedure": "township",
                          "skip_counties": ["COOK", "LAKE"],
                          "spec": "deliverables/township-card.md", "recipes": ["browser", "html-capture", "tiled-capture", "pdf-sheets", "saving-files"]},
    "township-prc":      {"any_of": ["township-prc-{slug}.pdf", "township-prc-{slug}.png"], "required": false, "procedure": "township",
                          "skip_counties": ["COOK", "LAKE"],
                          "spec": "deliverables/township-card.md", "recipes": ["browser", "html-capture", "tiled-capture", "pdf-sheets", "saving-files"]},
    "township-sketch":   {"files": ["township-sketch-{slug}.png"],   "required": false, "procedure": "township",
                          "skip_counties": ["COOK", "LAKE"],
                          "spec": "deliverables/township-card.md", "recipes": ["browser", "html-capture", "tiled-capture", "saving-files"]},
    "township-photo":    {"files": ["township-photo-{slug}.png"],    "required": false, "procedure": "township",
                          "skip_counties": ["COOK", "LAKE"],
                          "spec": "deliverables/township-card.md", "recipes": ["browser", "html-capture", "tiled-capture", "saving-files"]},
    "mls-listing":       {"prefix": "mls-listing", "suffix": "-{slug}", "ext": ".pdf", "subfolder": "MLS Listings",
                          "hint": "mls-listing-<year>-<MLS#>-{slug}.pdf, one per listing (more than 2: in MLS Listings\\)",
                          "required": false, "procedure": "mls", "needs_signin": "connectmls",
                          "spec": "deliverables/mls-listing.md", "recipes": ["browser", "saving-files"]},
    "flood-map":         {"files": ["flood-map-{slug}.png"],         "required": false, "procedure": "flood",
                          "spec": "deliverables/flood-map.md", "recipes": ["browser", "pdf-sheets", "saving-files"]},
    "market-graphs":     {"files": ["market-median-sale-price-{slug}.png", "market-average-sale-price-{slug}.png",
                                    "market-median-price-per-sq-ft-{slug}.png", "market-average-price-per-sq-ft-{slug}.png",
                                    "market-median-market-time-{slug}.png", "market-average-market-time-{slug}.png",
                                    "market-median-pct-orig-list-price-{slug}.png", "market-average-pct-orig-list-price-{slug}.png"],
                          "not_for_multi_unit": ["market-median-price-per-sq-ft-{slug}.png", "market-average-price-per-sq-ft-{slug}.png"],
                          "all_files": true, "required": false, "procedure": "market", "needs_signin": "connectmls",
                          "spec": "deliverables/market-graphs.md", "recipes": ["browser", "saving-files"]},
    "market-conditions": {"files": ["market-conditions-{slug}.pdf"], "required": false, "procedure": "market", "needs_signin": "connectmls",
                          "spec": "deliverables/market-conditions.md", "recipes": ["browser", "saving-files"]}
  },

  "procedure_order": ["county", "township", "flood", "market", "mls"],

  "always_read": ["RULES.md"],
  "browser_adapters": ["browser/claude-in-chrome.md", "browser/chatgpt.md"],
  "lookup_spec": "deliverables/county-lookup.md",
  "townships_file": "townships.json",
  "tools": ["tools/stitch.py", "tools/zoning_compose.py", "tools/market_conditions.py", "tools/pdf.py"]
}
